# ==============================================================================
# NexGuard Local Environment & Docker Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / BROWSER VARIABLES (Safe to expose to Next.js / Client Browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Backend / Node.js Only — NEVER expose to browser!)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Supabase Admin / Service Role Credentials (CRITICAL: Keep Private!)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=datasets

# File Upload & Rate Limiting Settings
MAX_FILE_SIZE_BYTES=52428800
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 3. EXTERNAL FASTAPI ML SERVICE CONFIGURATION (AI Team Service)
# ------------------------------------------------------------------------------
# Default local URL or Docker service URL (e.g., http://localhost:8000 or http://ml-service:8000)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=10000
